{
  "version": 1,
  "description": "Language-neutral conformance vectors for the euRedact rule engine. Both the Python and the TypeScript SDK run these, so cross-SDK parity is a test rather than an assumption. Each case is input plus an expectation; no language-specific detail belongs here.",
  "schema": {
    "id": "unique, kebab-case",
    "text": "input passed to redact()",
    "countries": "list of ISO 3166-1 alpha-2 codes, or null for no country hint",
    "mustDetect": "map of entity type -> exact list of detected texts for that type, in document order",
    "mustNotDetect": "list of entity types that must produce no detection"
  },
  "cases": [
    {
      "id": "de-plate-icd10-bare",
      "text": "ICD-10",
      "countries": ["DE"],
      "mustNotDetect": ["LICENSE_PLATE"]
    },
    {
      "id": "de-plate-icd10-in-clinical-text",
      "text": "Diagnose: Diabetes mellitus Typ 2 (ICD-10: E11.9) gesichert.",
      "countries": ["DE"],
      "mustNotDetect": ["LICENSE_PLATE"]
    },
    {
      "id": "de-plate-icd10-in-prose",
