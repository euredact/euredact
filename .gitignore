# OS
.DS_Store

# Secrets and credentials — never commit these
*.pem
*.key
*.pub
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
# Anchored to the repo root: these are the SSH keypair. Unanchored, the
# pattern also matched euredact-python/src/euredact/, silently hiding new
# source files from git.
/euredact
/euredact.pub
credentials.json
service-account.json
.npmrc
*.secret
*.secrets

# Python
__pycache__/
*.pyc
*.pyo
*.py[codz]
.venv*/
*.egg-info/
build/
.pytest_cache/
.benchmarks/
.mypy_cache/
.ruff_cache/
.env
.envrc

# Python evaluation outputs (regenerated on each run)
euredact-python/evaluation_report.html
euredact-python/false_positives_*.json

# Node / TypeScript
node_modules/

# Build outputs
dist/

# Tooling artifacts
.playwright-mcp/

# Claude Code: machine-local permissions state (skills in .claude/skills are shared)
.claude/settings.local.json
